{
  "name": "dsh-channel-hub",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "DSH 渠道中心：账号、动态目录、用量与请求日志",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "LICENSE",
    "sources.json",
    "docs/ACCEPTANCE.md",
    "dist/index.js",
    "dist/client.js",
    "dist/ledger-worker.js",
    "dist/qoder-auth-wasm.wasm"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --import ./tests/resolve-vendor.mjs --test --experimental-transform-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:errors && npm run build && npm run test:client && npm run test:host && npm run test:package",
    "test:client": "node --test tests/client.test.mjs",
    "test:errors": "node --import ./tests/resolve-vendor.mjs --test --experimental-transform-types tests/qoder-errors.test.mjs tests/buddy-errors.test.mjs tests/trae-cache.test.mjs tests/loomy-raccoon-credits.test.mjs",
    "test:host": "node scripts/verify-host.mjs",
    "pack:local": "node scripts/pack.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"src/drivers/*.js\" \"tests/*\" \"scripts/*.mjs\"",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "6.1.3",
    "undici": "8.11.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
